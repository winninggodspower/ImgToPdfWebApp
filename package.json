    "@babel/preset-react": "^7.24.7",
    "babel-loader": "^9.2.1",
    "concurrently": "^8.2.2",
    "daisyui": "^4.12.13",
    "tailwindcss": "^3.4.10",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "flowbite": "^2.5.1",
    "lucide-react": "^0.446.0",
