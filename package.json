{
  "name": "imgtopdfwebapp",
  "version": "1.0.0",
  "main": "static/js/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "webpack --config webpack.config.js && npx tailwindcss -i ./src/static/css/input.css -o ./src/static/css/output.css",
    "watch-js": "webpack --watch",
    "serve-js": "webpack serve",
    "watch-css": "npx tailwindcss -i ./src/static/css/input.css -o ./src/static/css/output.css --watch",
    "start": "concurrently \"npm run watch-js\" \"npm run watch-css\" \"npm run serve-js\""
  },
